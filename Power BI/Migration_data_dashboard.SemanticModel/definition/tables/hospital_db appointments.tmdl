table 'hospital_db appointments'
	lineageTag: 1f8c1587-666e-454c-8051-d1e7f12fb378

	measure Total_Appointments = COUNTROWS('hospital_db appointments')
		formatString: 0
		lineageTag: 6d84e310-b489-489c-964b-cf467656b97c

	measure 'New measure:Completed' =
			CALCULATE(
			    COUNTROWS('hospital_db appointments'),
			    'hospital_db appointments'[status] = "Completed"
			)
		formatString: 0
		lineageTag: 36a63040-3ffb-4bfe-9e33-c54644208260

	column appointmentID
