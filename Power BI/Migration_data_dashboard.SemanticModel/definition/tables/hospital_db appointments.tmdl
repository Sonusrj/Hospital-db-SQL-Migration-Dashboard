	partition 'hospital_db appointments' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost", "hospital_db", [ReturnSingleDatabase=true]),
				    hospital_db_appointments = Source{[Schema="hospital_db",Item="appointments"]}[Data],
				    #"Removed Columns" = Table.RemoveColumns(hospital_db_appointments,{"hospital_db.bills", "hospital_db.doctors", "hospital_db.labreports", "hospital_db.patients", "hospital_db.prescriptions"})
				in
